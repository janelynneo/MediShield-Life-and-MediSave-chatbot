# ============================================================
# Environment Configuration Template
# Copy to .env and fill in your API keys:  cp .env.example .env
# ============================================================

# ── LLM Configuration ───────────────────────────────────────
# At minimum, configure ONE provider with its API key and model.

# OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_PROD_MODEL=gpt-4o
# OPENAI_DEV_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google (Gemini)
# GOOGLE_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here

# DeepSeek
# DEEPSEEK_API_KEY=your-key-here

# Mistral
# MISTRAL_API_KEY=your-key-here

# Perplexity
# PERPLEXITY_API_KEY=pplx-your-key-here

# ── Default Model ───────────────────────────────────────────
# Fallback model used when no specific model is configured.
# DEFAULT_LLM_MODEL=gpt-4o

# ── Database ────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0

# ── Authentication ──────────────────────────────────────────
# JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# ── Application ─────────────────────────────────────────────
# APP_ENV=development
# DEBUG=true
# LOG_LEVEL=INFO

# ── MediShield Chatbot ────────────────────────────────────
# Required for the MediShield Life & MediSave chatbot (langchain OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Users ─────────────────────────────────────────────────
# Named users with bcrypt-hashed passwords.
# To generate a hash locally: python -c "from utils.auth import hash_password; print(hash_password('your_password'))"
# Format: USERS_JSON='{"username":{"password":"$2b$12$hash_here","role":"admin|user"}}'
# Roles: "admin" = full access (chat + statement upload + admin upload)
#        "user"  = chat + statement upload only
USERS_JSON='{"admin":{"password":"$2b$12$YOUR_HASH_HERE","role":"admin"}}'

# ── Cloudflare Workers AI (for statement OCR) ───────────────
# Get your Account ID at: https://dash.cloudflare.com/account
# Create an API Token at: https://dash.cloudflare.com/profile/api-tokens
# (Needs "Account" > "AI" > "Read" permission)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
